{
  "expo": {
    "name": "bookrats",
    "slug": "bookrats",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/logo/ios-app-store-1024.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#B5532F",
        "foregroundImage": "./public/logo/android-adaptive-foreground-432.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bookrats.app"
    },
    "web": {
      "favicon": "./public/logo/favicon-32.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "scheme": "bookrats",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6ed303d1-a864-4b20-9101-a66c65a484ee"
      }
    },
    "owner": "elyfranks-team"
  }
}
